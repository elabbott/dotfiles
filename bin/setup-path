#!/usr/bin/env bash
# setup-path: Add dotfiles/bin to PATH in shell configuration files
# Usage: setup-path [--zsh] [--bash] [--fish] [--all] [--dry-run]

set -e

# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Determine dotfiles directory
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# If DOTFILES_DIR is not set and we're running from the repo, use that
if [ ! -d "$DOTFILES_DIR" ] && [ -d "$SCRIPT_DIR" ]; then
    DOTFILES_DIR="$(dirname "$SCRIPT_DIR")"
fi

# Verify dotfiles directory exists
if [ ! -d "$DOTFILES_DIR/bin" ]; then
    echo -e "${RED}❌ Error: dotfiles/bin directory not found at $DOTFILES_DIR/bin${NC}"
    exit 1
fi

DRY_RUN=false
SETUP_ZSH=false
SETUP_BASH=false
SETUP_FISH=false

# Parse arguments
for arg in "$@"; do
    case $arg in
        --zsh)   SETUP_ZSH=true ;;
        --bash)  SETUP_BASH=true ;;
        --fish)  SETUP_FISH=true ;;
        --all)   SETUP_ZSH=true; SETUP_BASH=true; SETUP_FISH=true ;;
        --dry-run) DRY_RUN=true ;;
        *)
            echo "Usage: setup-path [--zsh] [--bash] [--fish] [--all] [--dry-run]"
            exit 1
            ;;
    esac
done

# If no specific shell chosen, auto-detect current shell
if [ "$SETUP_ZSH" = false ] && [ "$SETUP_BASH" = false ] && [ "$SETUP_FISH" = false ]; then
    case "$SHELL" in
        */zsh) SETUP_ZSH=true ;;
        */bash) SETUP_BASH=true ;;
        */fish) SETUP_FISH=true ;;
        *)
            echo -e "${YELLOW}⚠️  Unknown shell: $SHELL${NC}"
            echo "Defaulting to zsh. Use --bash, --fish, or --all to add to other shells."
            SETUP_ZSH=true
            ;;
    esac
fi

echo -e "${BLUE}🔧 Setup PATH for dotfiles/bin${NC}"
echo "Dotfiles location: $DOTFILES_DIR"
[ "$DRY_RUN" = true ] && echo -e "${YELLOW}Dry run mode - no changes will be made${NC}"
echo ""

# Function to add path to shell config
add_to_shell() {
    local shell_name=$1
    local config_file=$2
    local line_to_add="export PATH=\"\$HOME/.dotfiles/bin:\$PATH\"  # Added by dotfiles setup-path"

    if [ ! -f "$config_file" ]; then
        if [ "$DRY_RUN" = true ]; then
            echo -e "${GREEN}✅ $shell_name${NC} - Would create $config_file"
            return
        fi
        
        echo -e "${GREEN}✅ $shell_name${NC} - Creating $config_file"
        mkdir -p "$(dirname "$config_file")"
        touch "$config_file"
    fi

    # Check if already added
    if grep -q "dotfiles/bin" "$config_file" 2>/dev/null; then
        echo -e "${YELLOW}⚠️  $shell_name${NC} - Already has dotfiles/bin in PATH"
        return
    fi

    if [ "$DRY_RUN" = true ]; then
        echo -e "${GREEN}✅ $shell_name${NC} - Would add to $config_file"
        echo "   Line: $line_to_add"
        return
    fi

    echo -e "${GREEN}✅ $shell_name${NC} - Adding to $config_file"
    echo "" >> "$config_file"
    echo "# Dotfiles bin directory" >> "$config_file"
    echo "$line_to_add" >> "$config_file"
}

# Setup zsh
if [ "$SETUP_ZSH" = true ]; then
    add_to_shell "zsh" "$HOME/.zshrc"
fi

# Setup bash
if [ "$SETUP_BASH" = true ]; then
    add_to_shell "bash" "$HOME/.bashrc"
fi

# Setup fish
if [ "$SETUP_FISH" = true ]; then
    local fish_config="$HOME/.config/fish/config.fish"
    local fish_line="set -gx PATH ~/.dotfiles/bin \$PATH  # Added by dotfiles setup-path"

    if [ ! -f "$fish_config" ]; then
        if [ "$DRY_RUN" = true ]; then
            echo -e "${GREEN}✅ fish${NC} - Would create $fish_config"
            return
        fi
        
        echo -e "${GREEN}✅ fish${NC} - Creating $fish_config"
        mkdir -p "$(dirname "$fish_config")"
        touch "$fish_config"
    fi

    # Check if already added
    if grep -q "dotfiles/bin" "$fish_config" 2>/dev/null; then
        echo -e "${YELLOW}⚠️  fish${NC} - Already has dotfiles/bin in PATH"
        return
    fi

    if [ "$DRY_RUN" = true ]; then
        echo -e "${GREEN}✅ fish${NC} - Would add to $fish_config"
        echo "   Line: $fish_line"
        return
    fi

    echo -e "${GREEN}✅ fish${NC} - Adding to $fish_config"
    echo "" >> "$fish_config"
    echo "# Dotfiles bin directory" >> "$fish_config"
    echo "$fish_line" >> "$fish_config"
fi

echo ""
if [ "$DRY_RUN" = true ]; then
    echo -e "${YELLOW}ℹ️  Dry run mode${NC}"
    echo "To apply changes, run: setup-path $*" | sed 's/ --dry-run//'
else
    echo -e "${GREEN}✨ PATH setup complete!${NC}"
    echo ""
    echo "To activate in your current shell, run:"
    echo -e "  ${BLUE}source ~/.zshrc${NC}   # or ~/.bashrc / ~/.config/fish/config.fish"
    echo ""
    echo "Or open a new terminal window."
fi
